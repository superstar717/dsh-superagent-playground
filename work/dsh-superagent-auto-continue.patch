+  const settings = h.runtime.store.settings()
+  h.runtime.store.saveSettings({ ...settings, executor: { ...settings.executor, maxWorkers: 1 } })
+  const one = await h.acceptedTicket(feishu('1', '@bot 修一'))
+  await h.runTool(one.sessionId, 'orchestrator_report', { state: 'ready', summary: 'Done' }); await h.runtime.idle()
+  idle(one.sessionId)
+  expect(h.runtime.store.tickets.get(one.ticket.id)!.ended).toBeDefined()
+  // Ticket two holds the only normal worker slot.
+  const two = await h.acceptedTicket(feishu('5', '@bot 修二'))
+  expect(h.agents.get(two.sessionId)!.status).toBe('running')
+  // A person's message on ticket one's thread resumes it at once in the slot kept beyond the limit, ahead of new launches.
+  h.runtime.receive(feishu('2', '@bot 继续', { root_id: 'om_1' })); await h.runtime.idle()
+  const resumed = h.runtime.store.tickets.get(one.ticket.id)!
+  expect(resumed.ended).toBeUndefined()
