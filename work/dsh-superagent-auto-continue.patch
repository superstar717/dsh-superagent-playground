+  expect(h.agents.get(one.sessionId)!.status).toBe('running')
+})
+
+it('takes the messages a ticket let go of out of its worker Session when it ends, so none starts a turn with its tools withdrawn', async () => {
+  const one = await h.acceptedTicket(feishu('1', '@bot 修一'))
+  const agent = h.agents.get(one.sessionId)!
+  // A bot's message on the ticket's thread waits in the running worker's inbox for a next turn.
+  h.runtime.receive(botMessage()); await h.runtime.idle()
+  const bot = h.deliveries.mock.calls.map(([call]) => call).filter(call => call.sessionId === one.sessionId).at(-1)!
+  expect(bot.text).toContain('CI 失败')
+  expect(agent.inbox.nextTurn.some(message => message.id === bot.id)).toBe(true)
+  // Its ready report ends the ticket: the message its worker never read goes to Eval, not to a worker whose tools are withdrawn.
+  await h.runTool(one.sessionId, 'orchestrator_report', { state: 'ready', summary: 'Done' }); await h.runtime.idle()
+  expect(h.runtime.store.tickets.get(one.ticket.id)!.ended).toBeDefined()
+  expect(agent.inbox.nextTurn.some(message => message.id === bot.id)).toBe(false)
+})
