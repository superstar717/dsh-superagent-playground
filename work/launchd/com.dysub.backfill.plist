<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dysub.backfill</string>
  <key>Comment</key>
  <string>dysub 逐月历史回填驱动器（单月隔离、失败跳过、锁被占即让路）</string>
