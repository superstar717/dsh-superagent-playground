  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/huweixing/.local/douyin-subscription/bin/dysub-backfill</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>21</integer>
    <key>Minute</key>
    <integer>30</integer>
